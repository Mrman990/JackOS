
cd "$(dirname "$0")"

if [ "$1" = "JACK_OS" ]; then

    echo "[1/8] Mengompilasi kernel.cpp..."
    clang++ --target=i686-elf -ffreestanding -fno-exceptions -fno-rtti -fno-asynchronous-unwind-tables -Ikernel -c kernel/kernel.cpp -o kernel.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi kernel gagal!"; exit 1; fi

    echo "[2/8] Mengompilasi kmalloc.cpp..."
    clang++ --target=i686-elf -ffreestanding -fno-exceptions -fno-rtti -fno-asynchronous-unwind-tables -Ikernel -c kernel/memori_menejeman/kmalloc.cpp -o kmalloc.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi kmalloc.cpp gagal!"; exit 1; fi

    echo "[3/8] Mengompilasi memory.cpp..."
    clang++ --target=i686-elf -ffreestanding -fno-exceptions -fno-rtti -fno-asynchronous-unwind-tables -fno-builtin -Ikernel -c kernel/memori_menejeman/memory.cpp -o memory.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi memory.cpp gagal!"; exit 1; fi

    echo "[4/8] Mengompilasi thread.c..."
    clang --target=i686-elf -ffreestanding -fno-asynchronous-unwind-tables -fno-stack-protector -c kernel/process/thread.c -o thread.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi thread.c gagal!"; exit 1; fi

    echo "[5/8] Mengompilasi scheduler.c..."
    clang --target=i686-elf -ffreestanding -fno-asynchronous-unwind-tables -fno-stack-protector -c kernel/process/scheduler.c -o scheduler.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi scheduler gagal!"; exit 1; fi

    echo "[6/8] Mengompilasi mutex.c..."
    clang --target=i686-elf -ffreestanding -fno-asynchronous-unwind-tables -fno-stack-protector -c kernel/process/mutex.c -o mutex.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi mutex gagal!"; exit 1; fi

    echo "[7/8] Mengompilasi loader.s..."
    clang --target=i686-elf -c loader/loader.s -o loader.o
    if [ $? -ne 0 ]; then echo "Error: Assembly loader gagal!"; exit 1; fi

    echo "[8/8] Melakukan linking ke kernel.bin..."
    ld.lld -m elf_i386 -T linker/linker.ld -o kernel.bin loader.o kernel.o kmalloc.o memory.o thread.o scheduler.o mutex.o
    if [ $? -ne 0 ]; then echo "Error: Linking gagal!"; exit 1; fi

    echo "Menjalankan QEMU..."
    qemu-system-i386 -kernel kernel.bin \
    -drive file=D:/data_JKOS/disk.img,format=raw,if=ide

else
    echo "Perintah tidak dikenali."
fi
