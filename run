cd "$(dirname "$0")"

if [ "$1" = "JACK_OS" ]; then
    echo "[1/7] Mengompilasi kernel.cpp..."
    clang++ --target=i686-elf -ffreestanding -fno-exceptions -fno-rtti -fno-asynchronous-unwind-tables -Ikernel -c kernel/kernel.cpp -o kernel.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi kernel gagal!"; exit 1; fi

    echo "[2/7] Mengompilasi kmalloc.cpp..."
    clang++ --target=i686-elf -ffreestanding -fno-exceptions -fno-rtti -fno-asynchronous-unwind-tables -Ikernel -c kernel/memori_menejeman/kmalloc.cpp -o kmalloc.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi kmalloc.cpp gagal!"; exit 1; fi

    echo "[3/7] Mengompilasi thread.c..."
    clang --target=i686-elf -ffreestanding -fno-asynchronous-unwind-tables -fno-stack-protector -c kernel/process/thread.c -o thread.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi thread.c gagal!"; exit 1; fi

    echo "[4/7] Mengompilasi scheduler.c..."
    clang --target=i686-elf -ffreestanding -fno-asynchronous-unwind-tables -fno-stack-protector -c kernel/process/scheduler.c -o scheduler.o
    if [ $? -ne 0 ]; then echo "Error: Kompilasi scheduler.c gagal!"; exit 1; fi

    echo "[5/7] Mengompilasi loader.s..."
    clang --target=i686-elf -c loader/loader.s -o loader.o
    if [ $? -ne 0 ]; then echo "Error: Assembly loader gagal!"; exit 1; fi

    echo "[6/7] Melakukan linking ke kernel.bin..."
    ld.lld -m elf_i386 -T linker/linker.ld -o kernel.bin loader.o kernel.o kmalloc.o thread.o scheduler.o
    if [ $? -ne 0 ]; then echo "Error: Linking gagal!"; exit 1; fi

    echo "[7/7] Menjalankan QEMU..."
    qemu-system-i386 -kernel kernel.bin

else
    echo "Perintah tidak dikenali."
fi